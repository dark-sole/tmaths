--
-- DaletOption: European option pricing with the Dalet distribution on Canton Network
--
-- The standard is PERP/reference/fundingbond/model.py (`dalet_price`) and its vectors.json;
-- the structure is that of solidity/src/DaletOption.sol.
--
-- Ruling 22'' (PERP HANDOFF): the log law is centred on the forward F = S e^{rT}, with no drift
-- term, and each leg is priced under its own numeraire. With s = sigma sqrt(T) and
-- w = ln(F/K)/s, the log legs are written in ln(F/K) and s, so that w, which is unbounded as s
-- falls, is never formed (R = s sqrt(1 + w^2) = sqrt(s^2 + ln(F/K)^2)):
--   C_log = (R + ln(F/K))/2,  P_log = (R - ln(F/K))/2
-- the one that is a difference evaluated as s^2 / (2 (R + |ln(F/K)|)); and the prices
--   C = S (1 - e^{-C_log})            the call in the asset, bounded by S
--   P = K e^{-rT} (1 - e^{-P_log})    the put in cash, bounded by K e^{-rT}
-- with 1 - e^{-x} as -expm1(-x). One formula on both sides of the money: no leg selection and
-- no parity step. Price parity C - P = S - K e^{-rT} is an identity of the exact prices.
--
-- Ruling 25: Decimal at the interface, Numeric 18 inside. The pricer computes at 30 places
-- (TMaths.W) and returns Numeric 18. `daletPrice` takes Decimal inputs and returns the same
-- Numeric 18 result; the cast to Decimal belongs to the contract where a charge settles, and is
-- directed: `toDecimalUp` for an amount a payer is charged, `toDecimalDown` for one received.
--
-- Rounding: call and put are charged amounts, rounded up: each is at or above the exact price.
-- `daletPriceLowerE` is the same core less the margin, floored at zero: at or below the exact
-- prices, for a leg that is subtracted.
-- The margin covers the rounding to 18 places (half a unit) and the 30-place working error:
-- 2 units in the last place plus one per 1e9 of S + K. Each price carries one margin, so
-- C - P departs from S - K e^{-rT} by at most the two margins.
--
-- Deltas are the derivatives of the prices in S (ruling 22''):
--   deltaCalls = dC/dS = 1 - e^{-C_log} (1 - D(w)),  deltaPut = -dP/dS = 1 - deltaCalls,
-- returned as magnitudes summing to exactly 1; 1 - D(w) by the stable tail
-- D(-|w|) = s^2 / (2 R (R + |ln(F/K)|)) when w >= 0, its complement when w < 0.
--
-- Errors (Left from daletPriceE): a non-positive S, K, T or sigma, a negative r; ZeroScale when
-- s < 1e-18.

module DaletOption where

import qualified DA.Numeric as N
import TMaths

-- | Result of pricing, at 18 places.
data OptionResult = OptionResult
  with
    callPrice  : Numeric 18  -- call price in quote terms, rounded up
    putPrice   : Numeric 18  -- put price in quote terms, rounded up
    deltaCalls : Numeric 18  -- dC/dS in [0, 1]
    deltaPut   : Numeric 18  -- -dP/dS in [0, 1] (= 1 - deltaCalls), the magnitude of a negative delta
  deriving (Show, Eq)

ulpN : N18
ulpN = 0.000000000000000001

-- | The rounding margin: 2 units in the last place plus one per 1e9 of S + K.
marginN : N18 -> N18 -> N18
marginN s k = intToNumeric (2 + truncate ((s + k) / 1000000000.0)) * ulpN

-- | The pricer, Numeric 18 in and out; Left on inputs outside its domain.
daletPriceE : N18 -> N18 -> N18 -> N18 -> N18 -> Either Text OptionResult
daletPriceE s k t r sigma = do
  (c, p, dc, dp) <- daletCoreE s k t r sigma
  let margin = marginN s k
  pure OptionResult with
    callPrice = c + margin; putPrice = p + margin; deltaCalls = dc; deltaPut = dp

-- | The lower-bound pricer beside daletPriceE: call and put at or below the exact prices, for
--   the leg of a spread that is subtracted (a difference of two prices rounded up is not rounded
--   up). The core's result less its margin, floored at zero. Returns (call, put).
daletPriceLowerE : N18 -> N18 -> N18 -> N18 -> N18 -> Either Text (N18, N18)
daletPriceLowerE s k t r sigma = do
  (c, p, _, _) <- daletCoreE s k t r sigma
  let margin = marginN s k
  pure (max 0.0 (c - margin), max 0.0 (p - margin))

-- | The lower-bound pricer; aborts on inputs outside its domain.
daletPriceLowerN : N18 -> N18 -> N18 -> N18 -> N18 -> (N18, N18)
daletPriceLowerN s k t r sigma = case daletPriceLowerE s k t r sigma of
  Left msg  -> error msg
  Right res -> res

-- | The prices before the margin, and the deltas: (call, put, deltaCalls, deltaPut).
daletCoreE : N18 -> N18 -> N18 -> N18 -> N18 -> Either Text (N18, N18, N18, N18)
daletCoreE s k t r sigma
  | s <= 0.0     = Left "DaletOption: spot must be positive"
  | k <= 0.0     = Left "DaletOption: strike must be positive"
  | t <= 0.0     = Left "DaletOption: time must be positive"
  | sigma <= 0.0 = Left "DaletOption: volatility must be positive"
  | r < 0.0      = Left "DaletOption: rate must not be negative"
  | otherwise =
      let
        -- s^2 = sigma^2 T and s, 30 places
        sig2 : W = N.mul sigma sigma
        s2 : W = N.mul sig2 t
        sv : W = sqrtW s2
      in if sv < 0.000000000000000001 then Left "DaletOption: ZeroScale: sigma sqrt(T) below 1e-18"
      else
        let
          rt : W = N.mul r t
          -- ln(F/K) = ln S - ln K + rT
          lfk : W = lnW s - lnW k + rt
          al = abs lfk
          -- R = s sqrt(1 + w^2)
          big = sqrtW (s2 + lfk * lfk)

          -- The log legs: the larger (R + |ln(F/K)|)/2, the smaller s^2 / (2 (R + |ln(F/K)|))
          larger : W = (big + al) / 2.0
          smaller : W = s2 / (2.0 * (big + al))
          (cLog, pLog) = if lfk >= 0.0 then (larger, smaller) else (smaller, larger)

          -- 1 - e^{-leg}
          omC : W = negate (expm1W (negate cLog))
          omP : W = negate (expm1W (negate pLog))

          -- Discount e^{-rT}
          disc : W = expW (negate rt)

          call : N18 = N.mul s omC
          put : N18 = N.mul k (disc * omP)

          -- Deltas: 1 - D(w) by the stable tail when w >= 0, its complement when w < 0
          tl : W = s2 / (2.0 * big * (big + al))
          survival = if lfk >= 0.0 then tl else 1.0 - tl
          dP : N18 = N.castAndRound ((1.0 - omC) * survival)
        in Right (call, put, 1.0 - dP, dP)

-- | The pricer, Numeric 18 in and out; aborts on inputs outside its domain.
daletPriceN : N18 -> N18 -> N18 -> N18 -> N18 -> OptionResult
daletPriceN s k t r sigma = case daletPriceE s k t r sigma of
  Left msg  -> error msg
  Right res -> res

-- | The Decimal interface: Decimal inputs, the Numeric 18 result.
--
--   Inputs:
--     s     - spot price     (e.g. 100.0 = $100)
--     k     - strike price   (e.g. 110.0 = $110)
--     t     - time to expiry in years (e.g. 0.25 = 3 months)
--     r     - risk-free rate as decimal (e.g. 0.05 = 5%)
--     sigma - volatility as decimal (e.g. 0.20 = 20%)
daletPrice : Decimal -> Decimal -> Decimal -> Decimal -> Decimal -> OptionResult
daletPrice s k t r sigma = daletPriceN (N.cast s) (N.cast k) (N.cast t) (N.cast r) (N.cast sigma)

-- ═══════════════════════════════════════════════════════════════════════════
-- Directed casts to Decimal, for the contract where a charge settles (ruling 25)
-- ═══════════════════════════════════════════════════════════════════════════

-- | An amount a payer is charged: rounded up to 10 places.
toDecimalUp : Numeric 18 -> Decimal
toDecimalUp x =
  let d : Decimal = N.castAndRound x
  in if (N.cast d : Numeric 18) < x then d + 0.0000000001 else d

-- | An amount received: rounded down to 10 places.
toDecimalDown : Numeric 18 -> Decimal
toDecimalDown x =
  let d : Decimal = N.castAndRound x
  in if (N.cast d : Numeric 18) > x then d - 0.0000000001 else d

-- | A quantity that is not an amount (a delta, a probability): nearest.
toDecimalNearest : Numeric 18 -> Decimal
toDecimalNearest = N.castAndRound
