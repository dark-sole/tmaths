module DaletTest where

import DaletOption
import DaletCDF
import DaletVectors
import Daml.Script
import DA.List (head)
import qualified DA.Numeric

-- ═══════════════════════════════════════════════════════════════════════════
-- DaletOption Test Suite
--
-- Tests European option pricing under the Dalet distribution. Until 24 September 2026 each
-- script dumped its values through `assertMsg ... False` and failed by design; each now asserts.
-- The cases of dalet_updated.tex Table 3 are checked against the reference vectors
-- (DaletVectors, from PERP vectors.json), now under ruling 22'': one formula on both sides of
-- the money, the law centred on the forward. The Table 3 figures in the comments below are
-- those of dalet_updated.tex, which is registered for amendment to 22''.
-- ═══════════════════════════════════════════════════════════════════════════

ulp : Numeric 18
ulp = 0.000000000000000001

-- | Format an OptionResult for display
showResult : Text -> OptionResult -> Text
showResult label r =
  label
  <> " | call=" <> show r.callPrice
  <> " | put=" <> show r.putPrice
  <> " | dC=" <> show r.deltaCalls
  <> " | dP=" <> show r.deltaPut

vector : Text -> PriceVector
vector i = head (filter (\v -> v.vid == i) priceVectors)

-- | The Decimal interface against a reference vector: prices at or above the exact value and
--   within three rounding margins; deltas within two units in the last place.
checkVector : Text -> Decimal -> Decimal -> Decimal -> Decimal -> Decimal -> Script ()
checkVector i s k t r sigma = do
  let v = vector i
      res = daletPrice s k t r sigma
      tol = 3.0 * marginN v.s v.k + 2.0 * ulp
      msg = showResult i res
  assertMsg (msg <> ": inputs") (v.s == numericOf s && v.k == numericOf k && v.t == numericOf t)
  assertMsg (msg <> ": call") (res.callPrice >= v.callC && res.callPrice - v.callC <= tol)
  assertMsg (msg <> ": put") (res.putPrice >= v.putC && res.putPrice - v.putC <= tol)
  assertMsg (msg <> ": delta call") (res.deltaCalls >= v.dcF - 2.0 * ulp && res.deltaCalls <= v.dcC + 2.0 * ulp)
  assertMsg (msg <> ": deltas sum to one") (res.deltaCalls + res.deltaPut == 1.0)

numericOf : Decimal -> Numeric 18
numericOf x = fromDecimal x

fromDecimal : Decimal -> Numeric 18
fromDecimal = DA.Numeric.cast

-- | Price-space parity C - P = S - K e^{-rT}, to the rounding margins.
checkParity : Text -> Decimal -> Decimal -> Decimal -> Decimal -> Decimal -> Numeric 18 -> Script ()
checkParity label s k t r sigma forward = do
  let res = daletPrice s k t r sigma
      margin = marginN (fromDecimal s) (fromDecimal k)
      err = (res.callPrice - res.putPrice) - forward
  assertMsg (showResult label res <> " | parity error " <> show err)
    (err >= negate (3.0 * margin) && err <= 3.0 * margin)

-- | The Dalet CDF, survival, PDF and quantile functions
testCDF : Script ()
testCDF = do
  -- D(1) = (1 + 1/sqrt 2)/2 = 0.85355339059327376..., D(2) = 0.94721359549995793...
  assertMsg "CDF(0)" (daletCdf 0.0 == 0.5)
  assertMsg "CDF(1)" (daletCdf 1.0 == 0.8535533906)
  assertMsg "CDF(-1)" (daletCdf (-1.0) == 0.1464466094)
  assertMsg "CDF(2)" (daletCdf 2.0 == 0.9472135955)
  assertMsg "CDF(3)" (daletCdf 3.0 == 0.9743416490)
  assertMsg "Surv(1)" (daletSurvival 1.0 == 0.1464466094)
  assertMsg "Symmetry" (daletCdf 1.0 + daletCdf (-1.0) == 1.0)
  -- PDF(0) = 1/2, PDF(1) = 1/(2 2^{3/2}) = 0.17677669529663688...
  assertMsg "PDF(0)" (daletPdf 0.0 == 0.5)
  assertMsg "PDF(1)" (abs (daletPdf 1.0 - 0.1767766953) <= 0.0000000002)
  assertMsg "Q(0.50)" (daletQuantile 0.5 == 0.0)
  -- Roundtrip: CDF(quantile(p)) = p to the last place
  assertMsg "CDF(Q(0.95))" (abs (daletCdf (daletQuantile 0.95) - 0.95) <= 0.0000000002)
  assertMsg "CDF(Q(0.01))" (abs (daletCdf (daletQuantile 0.01) - 0.01) <= 0.0000000002)

-- | Standard ATM option: S=100, K=100, T=0.25 (3 months), r=5%, σ=20% (Table 3: 5.47, 4.22)
testATM : Script ()
testATM = checkVector "table3/K100" 100.0 100.0 0.25 0.05 0.20

-- | ITM call / OTM put: S=100, K=90 (Table 3: 13.01, 1.89). Under 22'' no leg is derived by parity.
testITM : Script ()
testITM = checkVector "table3/K90" 100.0 90.0 0.25 0.05 0.20

-- | OTM call / ITM put: S=100, K=110 (Table 3: 2.26, 10.89). Under 22'' no leg is derived by parity.
testOTM : Script ()
testOTM = checkVector "table3/K110" 100.0 110.0 0.25 0.05 0.20

-- | Longer expiry: T=1.0 (Table 3: 11.68, 6.80)
testLongExpiry : Script ()
testLongExpiry = checkVector "table3/one_year" 100.0 100.0 1.0 0.05 0.20

-- | High volatility: σ=50% (Table 3: 12.14, 10.89)
testHighVol : Script ()
testHighVol = checkVector "table3/high_vol" 100.0 100.0 0.25 0.05 0.50

-- | Low volatility: σ=5%. No vector; parity to the margins and a positive put.
--   S - K e^{-0.0125} = 100 (1 - e^{-0.0125}) = 1.2422199506...
testLowVol : Script ()
testLowVol = do
  checkParity "LowVol S=100 K=100 T=0.25 r=5% σ=5%" 100.0 100.0 0.25 0.05 0.05 1.242219950611857193
  let res = daletPrice 100.0 100.0 0.25 0.05 0.05
  assertMsg (showResult "LowVol" res <> ": put positive") (res.putPrice > 0.0)

-- | Deep OTM call: S=100, K=150 (Table 3: 0.61, 48.75)
testDeepOTM : Script ()
testDeepOTM = checkVector "table3/K150" 100.0 150.0 0.25 0.05 0.20

-- | Deep ITM call: S=100, K=60. No vector; parity to the margins, call above intrinsic.
--   S - K e^{-0.0125} = 100 - 60 e^{-0.0125} = 40.7453319704...
testDeepITM : Script ()
testDeepITM = do
  checkParity "DeepITM S=100 K=60 T=0.25 r=5% σ=20%" 100.0 60.0 0.25 0.05 0.20 40.745331970367114316
  let res = daletPrice 100.0 60.0 0.25 0.05 0.20
  assertMsg (showResult "DeepITM" res <> ": call above S - K") (res.callPrice > 40.0)

-- | Put-call parity: C - P = S - K e^{-rT}, model-free, now exact to the rounding margins.
--   S - K e^{-0.025} = 100 - 105 e^{-0.025} = -2.4075407630...
testParity : Script ()
testParity =
  checkParity "PARITY S=100 K=105 T=0.5 r=5% σ=20%" 100.0 105.0 0.5 0.05 0.20 (-2.407540762974930206)

-- | Run all
testAllDalet : Script ()
testAllDalet = do
  testATM
  testITM
  testOTM
  testLongExpiry
  testHighVol
  testLowVol
  testDeepOTM
  testDeepITM
  testParity
