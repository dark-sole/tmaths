--
-- TMaths: exp, ln, sqrt and expm1 for option pricing on Canton Network
--
-- Ruling 25 (PERP HANDOFF, 24 September 2026): Decimal at the interface, Numeric 18 inside for
-- pricing and accrual. Every function here is computed at 30 places (type W, Numeric 30) and
-- delivered at 18 (Numeric 18) to within half a unit in the last place:
--
--   lnN, expN, expm1N, sqrtN : Numeric 18 -> Numeric 18
--   lnW (from Numeric 18), expW, expm1W, sqrtW : ... -> Numeric 30, for callers that keep the
--   guard digits (DaletOption)
--
-- The Decimal functions tExp, tLn and tSqrt are kept for existing callers and are now the
-- Numeric 18 functions rounded to 10 places. They replace the 2025 Taylor versions, whose ln
-- carried an absolute error up to 4.9e-4 (7 terms) and exp up to 1.6e-4 (5 terms).
--
-- Methods:
--   ln   x = j ln 10 + k ln 2 + ln z, with 10^j <= x < 10^(j+1) and z = x / (10^j 2^k) in
--        [0.75, 1.5); ln z = 2 atanh(u), u = (z-1)/(z+1), |u| <= 0.2, summed until the term
--        vanishes at 30 places (about 21 terms).
--   exp  x = 2^k e^r, k = round(x / ln 2), |r| <= 0.35, Taylor series to 30 places.
--   expm1 x: the Taylor series from the linear term for |x| < 0.5, so that nothing cancels;
--        exp x - 1 above.
--   sqrt x = 10^j sqrt(y), y = x / 100^j in [1, 100), Newton from (y + 1)/2, which lies above
--        the root, until the iterate stops falling.
--
-- Domains: expN overflows Numeric 18 above x = 46 (e^46 > 1e20); the W functions keep their
-- results below 1e8.

module TMaths where

import qualified DA.Numeric as N

-- | 18 places: the pricing and accrual type (ruling 25).
type N18 = Numeric 18

-- | 30 places: the working type, twelve guard digits over N18.
type W = Numeric 30

-- ═══════════════════════════════════════════════════════════════════════════
-- CONSTANTS (30 places, rounded to nearest)
-- ═══════════════════════════════════════════════════════════════════════════

-- ln 2 = 0.693147180559945309417232121458176568...
ln2W : W
ln2W = 0.693147180559945309417232121458

-- ln 10 = 2.302585092994045684017991454684364207...
ln10W : W
ln10W = 2.302585092994045684017991454684

-- ═══════════════════════════════════════════════════════════════════════════
-- HELPERS
-- ═══════════════════════════════════════════════════════════════════════════

-- | 10^j as an exact integer, j >= 0.
pow10I : Int -> Numeric 0
pow10I j = if j <= 0 then intToNumeric 1 else intToNumeric 10 * pow10I (j - 1)

-- | 2^j as an exact integer, j >= 0.
pow2I : Int -> Numeric 0
pow2I j = if j <= 0 then intToNumeric 1 else intToNumeric 2 * pow2I (j - 1)

-- | 10^j at 18 places, -18 <= j <= 19.
tenPowN : Int -> N18
tenPowN j
  | j >= 0    = N.castAndRound (pow10I j)
  | otherwise = N.div (intToNumeric 1 : Numeric 0) (pow10I (negate j))

-- | The decimal exponent j of x > 0: 10^j <= x < 10^(j+1).
decExp : N18 -> Int
decExp x = if x >= 1.0 then decUp x 0 else decDown x (-1)

decUp : N18 -> Int -> Int
decUp x j = if j < 19 && x >= tenPowN (j + 1) then decUp x (j + 1) else j

decDown : N18 -> Int -> Int
decDown x j = if x >= tenPowN j then j else decDown x (j - 1)

-- | Nearest integer, halves away from zero.
roundW : W -> Int
roundW v = truncate (if v >= 0.0 then v + 0.5 else v - 0.5)

tAbs : Decimal -> Decimal
tAbs x = if x < 0.0 then negate x else x

-- ═══════════════════════════════════════════════════════════════════════════
-- NATURAL LOGARITHM
-- ═══════════════════════════════════════════════════════════════════════════

-- | ln z for z in [0.75, 1.5): 2 atanh((z-1)/(z+1)).
lnNear1 : W -> W
lnNear1 z =
  let u = (z - 1.0) / (z + 1.0)
  in 2.0 * atanhSum (u * u) u 1 0.0

-- | Sum of term/n over odd n, the term multiplied by u^2 each step, until it vanishes.
atanhSum : W -> W -> Int -> W -> W
atanhSum u2 term n acc =
  if term == 0.0 then acc else atanhSum u2 (term * u2) (n + 2) (acc + term / intToNumeric n)

-- | ln x at 30 places, x > 0 at 18.
lnW : N18 -> W
lnW x
  | x <= 0.0  = error "TMaths.ln: input must be positive"
  | otherwise =
      let j = decExp x
          y : W = if j >= 0 then N.div x (pow10I j) else N.mul x (pow10I (negate j))
          (k, z) = halveBelow y 0
      in intToNumeric j * ln10W + intToNumeric k * ln2W + lnNear1 z

-- | (k, y / 2^k) with y / 2^k below 1.5.
halveBelow : W -> Int -> (Int, W)
halveBelow y k = if y >= 1.5 then halveBelow (y / 2.0) (k + 1) else (k, y)

-- | ln x at 18 places.
lnN : N18 -> N18
lnN x = N.castAndRound (lnW x)

-- ═══════════════════════════════════════════════════════════════════════════
-- EXPONENTIAL
-- ═══════════════════════════════════════════════════════════════════════════

-- | e^r for |r| <= 0.35, Taylor series to 30 places.
expSeries : W -> W
expSeries r = taylorTail r r 2 (1.0 + r)

-- | Adds the terms x^n/n! from the given n on, each from the last, until one vanishes.
taylorTail : W -> W -> Int -> W -> W
taylorTail x term n acc =
  let t = term * x / intToNumeric n
  in if t == 0.0 then acc else taylorTail x t (n + 1) (acc + t)

-- | x = k ln 2 + r: (k, e^r).
expParts : W -> (Int, W)
expParts x =
  let k = roundW (x / ln2W)
      r = x - intToNumeric k * ln2W
  in (k, expSeries r)

-- | e^x at 30 places; the result must lie below 1e8 (x < 18.42).
expW : W -> W
expW x
  | x < -70.0 = 0.0
  | otherwise =
      let (k, er) = expParts x
      in if k >= 0 then N.mul er (pow2I k) else N.div er (pow2I (negate k))

-- | e^x at 18 places; overflows above x = 46.
expN : N18 -> N18
expN x
  | x < -43.0 = 0.0
  | otherwise =
      let (k, er) = expParts (N.cast x)
      in if k >= 0 then N.mul er (pow2I k) else N.div er (pow2I (negate k))

-- | e^x - 1 at 30 places: the series from the linear term below |x| = 0.5, so that the
--   subtraction of 1 cancels nothing; exp x - 1 above.
expm1W : W -> W
expm1W x
  | x == 0.0               = 0.0
  | x > -0.5 && x < 0.5    = taylorTail x x 2 x
  | otherwise              = expW x - 1.0

-- | e^x - 1 at 18 places.
expm1N : N18 -> N18
expm1N x
  | x > -0.5 && x < 0.5 = N.castAndRound (expm1W (N.cast x))
  | otherwise           = expN x - 1.0

-- ═══════════════════════════════════════════════════════════════════════════
-- SQUARE ROOT
-- ═══════════════════════════════════════════════════════════════════════════

-- | sqrt y for y in [1, 100): Newton from (y + 1)/2, above the root by AM-GM, until the
--   iterate stops falling.
newtonSqrt : W -> W
newtonSqrt y = newtonFrom y ((y + 1.0) / 2.0)

newtonFrom : W -> W -> W
newtonFrom y g = let g' = (g + y / g) / 2.0 in if g' >= g then g else newtonFrom y g'

-- | sqrt x at 30 places, 0 <= x < 1e8.
sqrtW : W -> W
sqrtW x
  | x < 0.0   = error "TMaths.sqrt: input must be non-negative"
  | x == 0.0  = 0.0
  | otherwise =
      let (y, j) = scale100 x 0
          g = newtonSqrt y
      in if j >= 0 then N.mul g (pow10I j) else N.div g (pow10I (negate j))

-- | (y, j) with x = y 100^j and y in [1, 100).
scale100 : W -> Int -> (W, Int)
scale100 y j
  | y >= 100.0 = scale100 (y / 100.0) (j + 1)
  | y < 1.0    = scale100 (y * 100.0) (j - 1)
  | otherwise  = (y, j)

-- | sqrt x at 18 places, for any non-negative Numeric 18.
sqrtN : N18 -> N18
sqrtN x
  | x < 0.0   = error "TMaths.sqrt: input must be non-negative"
  | x == 0.0  = 0.0
  | otherwise =
      let j = decExp x
          e = if j % 2 == 0 then j else j - 1      -- even, e <= j: x / 10^e in [1, 100)
          y : W = if e >= 0 then N.div x (pow10I e) else N.mul x (pow10I (negate e))
          g = newtonSqrt y
          h = e / 2
      in if h >= 0 then N.mul g (pow10I h) else N.div g (pow10I (negate h))

-- ═══════════════════════════════════════════════════════════════════════════
-- DECIMAL INTERFACE (10 places): the Numeric 18 functions, rounded to nearest
-- ═══════════════════════════════════════════════════════════════════════════

tExp : Decimal -> Decimal
tExp x = N.castAndRound (expN (N.cast x))

tLn : Decimal -> Decimal
tLn x
  | x <= 0.0  = error "TMaths.tLn: input must be positive"
  | otherwise = N.castAndRound (lnN (N.cast x))

tSqrt : Decimal -> Decimal
tSqrt x
  | x < 0.0   = error "TMaths.tSqrt: input must be non-negative"
  | otherwise = N.castAndRound (sqrtN (N.cast x))
